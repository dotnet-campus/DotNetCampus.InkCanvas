<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:InkBeautifierAvaloniaDemo"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="InkBeautifierAvaloniaDemo.MainWindow"
        Width="1100" Height="720" MinWidth="720" MinHeight="480"
        Title="笔迹美化画板">
    <Grid RowDefinitions="Auto,*" Background="#EEF1F5">
        <Border Padding="16,12" Background="#FAFBFC" BorderBrush="#D8DEE8" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,160,Auto,160,*,Auto" ColumnSpacing="12">
                <TextBlock VerticalAlignment="Center" Text="笔宽" />
                <Slider x:Name="WidthSlider" Grid.Column="1" Minimum="4" Maximum="32" Value="12" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="速度响应" />
                <Slider x:Name="ResponseSlider" Grid.Column="3" Minimum="0.2" Maximum="5" Value="2" />
                <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="#667085"
                           Text="慢速更饱满，快速自动收窄；支持鼠标、触控笔和触摸。" />
                <Button Grid.Column="5" Padding="18,8" Click="ClearButton_OnClick" Content="清空" />
            </Grid>
        </Border>
        <Border Grid.Row="1" Margin="18" Background="White" CornerRadius="12"
                BorderBrush="#D8DEE8" BorderThickness="1" BoxShadow="0 8 24 0 #16000000">
            <local:InkCanvas x:Name="InkCanvas" MaximumWidth="12" VelocityResponse="2" />
        </Border>
    </Grid>
</Window>
